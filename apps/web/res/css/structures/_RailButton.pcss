/* Same look as the quick settings button at the bottom of the space panel. */
.mx_RailButton {
    /* !important override compound */
    border-radius: 8px !important;
    margin: 4px auto 8px;

    svg {
        fill: $secondary-content;
    }

    &:not(.expanded):hover {
        background-color: $quaternary-content !important;

        svg {
            fill: $primary-content;
        }
    }

    &.expanded {
        background-color: transparent !important;

        /* align with the icons of the other expanded buttons */
        margin-left: 19px;
        margin-right: 8px;
        width: 100%;
        /* the margins are inside the rail when it is dragged narrow, and a long label is cut, not spilled over the chat */
        max-width: calc(100% - 27px);
        min-width: 0;

        /* the compound component wraps its children in a div */
        & > div {
            display: flex;
            align-items: center;
            min-width: 0;
        }

        svg {
            margin-right: 11px;
            width: 24px;
            flex-shrink: 0;
        }

        & .mx_RailButton_label {
            color: $secondary-content !important;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }
}

/* Without the user menu above them (the user panel replaces it), the first rail button needs its own top spacing. */
.mx_SpacePanel > :not(.mx_RailButton) + .mx_RailButton {
    margin-top: 12px;
}
