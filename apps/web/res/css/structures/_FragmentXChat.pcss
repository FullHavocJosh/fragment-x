/*
 * fragment_x.chat_cosmetics: the time beside the name of the sender, a date pill and a plus at the left of the composer.
 * LoggedInView puts the class on the app wrapper.
 */
.mx_MatrixChat_fragmentXChat {
    /* The time beside the name of the sender, in the first message of a group. */
    .mx_EventTile_senderLine {
        display: flex;
        align-items: baseline;
        gap: var(--cpd-space-2x);

        .mx_MessageTimestamp {
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-xs-regular);
            white-space: nowrap;
        }
    }

    /* ...so the same time is not also in the gutter of that message */
    .mx_EventTile:has(.mx_EventTile_senderLine) [data-testid="event-tile-slot-timestamp"] {
        visibility: hidden;
    }

    /* The date between days: a pill in the middle of the line. */
    .mx_TimelineSeparator {
        gap: var(--cpd-space-3x);
        margin-block: var(--cpd-space-3x);

        > hr {
            border-bottom-color: var(--cpd-color-bg-subtle-secondary);
        }

        > :not(hr) {
            padding: var(--cpd-space-1x) var(--cpd-space-4x);
            border-radius: 999px;
            background-color: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-xs-semibold);
        }
    }

    /*
     * The plus: the buttons stay in the DOM order (editor, emoji, more, send) but the attachment button goes first in the
     * row, so it is at the left of the editor.
     */
    .mx_MessageComposer.mx_MessageComposer_plusLeft {
        .mx_MessageComposer_row {
            gap: var(--cpd-space-1-5x);
        }

        .mx_MessageComposer_actions {
            display: contents;
        }

        .mx_MessageComposer_upload {
            order: -1;
        }
    }
}
