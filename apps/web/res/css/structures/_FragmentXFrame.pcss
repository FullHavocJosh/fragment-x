/*
 * fragment_x.unified_frame: the rail and the top bar are one frame around the chat, and the icons in the bars share a
 * size. LoggedInView puts the class on the app wrapper.
 */
.mx_MatrixChat_fragmentXFrame {
    /*
     * The frame is a grid of square cells as wide as the rail. The top bar is one cell high, so the search icon sits at
     * the centre of both the rail column and the bar next to it, and an icon at the right end of the bar is as far from
     * the edge as the search icon is from the left one.
     */
    --fragmentXFrameCell: 68px;
    /* the corner where the rail and the top bar meet the chat */
    --fragmentXFrameRadius: 16px;
    /* an icon button is 32px, with 8px around it in a small cell */
    --fragmentXIconPad: 8px;

    /*
     * The corner where the rail and the top bar meet the chat is rounded. It is a notch in the frame's colour laid over
     * the chat's own corner, so it does not depend on what colour the chat has.
     */
    .mx_RoomView_timeline {
        position: relative;

        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            z-index: 5;
            width: var(--fragmentXFrameRadius);
            height: var(--fragmentXFrameRadius);
            pointer-events: none;
            background-color: var(--cpd-color-bg-subtle-primary);
            mask: radial-gradient(
                circle at 100% 100%,
                transparent var(--fragmentXFrameRadius),
                #000 calc(var(--fragmentXFrameRadius) + 0.5px)
            );
        }
    }

    /*
     * The composer row is centred in a cell as high as the top bar, which puts it level with the user's avatar at the
     * bottom of the rail. A composer with several lines grows upwards from there.
     */
    .mx_RoomView .mx_MessageComposer {
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        min-height: var(--fragmentXFrameCell);
        padding-bottom: 0;
    }

    .mx_MessageComposer_wrapper {
        margin: 0;
    }

    /*
     * One hover for every icon that is not a person, a space or a room: no box behind it, the icon brightens and
     * glows. (Search, Collapse, Inbox, settings and the icons in the top bar.)
     */
    .mx_RailButton,
    .mx_ThreadsActivityCentreButton,
    .mx_UserPanel_button,
    .mx_RoomHeader [class*="_icon-button_"] {
        &:hover,
        &:focus-visible {
            background-color: transparent !important;
        }

        svg {
            transition:
                filter 0.15s ease,
                fill 0.15s ease;
        }

        &:hover svg,
        &:focus-visible svg {
            fill: var(--cpd-color-icon-primary) !important;
            filter: drop-shadow(0 0 5px var(--cpd-color-icon-primary));
        }
    }

    /* the avatar's centre is 34px from the bottom, and the settings icon is one icon pitch above it */
    .mx_SpacePanel.mx_SpacePanel_unified .mx_UserPanel.mx_UserPanel_compact {
        padding: var(--fragmentXIconPad) 0 calc((var(--fragmentXFrameCell) - 32px) / 2);
        gap: calc(var(--fragmentXIconPad) * 2);
    }

    /* the icon buttons of the rail set their own box with !important on :not(.expanded):hover, so these match that */
    .mx_RailButton:not(.expanded):hover,
    .mx_ThreadsActivityCentreButton:not(.expanded):hover,
    .mx_ThreadsActivityCentreButton:not(.expanded):hover .mx_ThreadsActivityCentreButton_Icon {
        background-color: transparent !important;
    }

    .mx_ThreadsActivityCentreButton:hover .mx_ThreadsActivityCentreButton_Icon {
        background-color: transparent !important;
    }

    /* The top bar has the rail's colour (the colour editor's Server rail colour sets both), and no line under it. */
    .mx_RoomHeader,
    .mx_RoomHeader:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-bottom-color: transparent;
    }

    .mx_RoomHeader {
        height: var(--fragmentXFrameCell);
        /* no line under it, so the icons are centred on the whole height */
        border-bottom-width: 0;
        /* icon buttons 32px apart from each other: the small padding twice */
        gap: calc(var(--fragmentXIconPad) * 2);
        /* the icon at the right end is as far from the edge as the search icon is from the left one: 34px to its centre */
        padding-right: calc(var(--fragmentXFrameCell) / 2 - 16px);
    }

    /* Every icon in the bars is a 24px glyph in a 32px button. */
    /* (.mx_SpaceButton too: this file loads before _SpacePanel.pcss, so it needs the higher specificity to win) */
    .mx_SpacePanel .mx_SpaceButton .mx_SpaceButton_icon {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    .mx_MessageComposer_button {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    /*
     * One icon axis: the icon of every row, whatever its depth, is centred on the same vertical line, so the rail reads as
     * one column. A space, a subspace, a room, Messages, Servers and a direct message all have the same 32px icon, so
     * there is no indent and no size to tell them apart: the highlights below group an open space and its subspaces.
     */
    .mx_SpacePanel {
        /* the centre of the slot: the gutter (14px), the selection padding (4px) and half the icon (16px) */
        --fragmentXRailAxis: 34px;
        /* where names start: after the slot and a gap */
        --fragmentXRailText: 58px;

        .mx_SpaceTreeLevel .mx_SpaceTreeLevel {
            padding-left: 0;
        }

        /* the tree is as wide as the rail (it stopped 22px short), so the trays and rows are inset the same on both sides */
        .mx_SpaceTreeLevel {
            max-width: none;
        }

        /*
         * Two levels of highlight: an open space and everything under it share one, and each open subspace with its rooms
         * has a second, darker one inset in it, so a subspace reads as a tray inside its space.
         */
        .mx_SpaceItem.hasSubSpaces:not(.collapsed) {
            position: relative;
            isolation: isolate;
            /* the same 4px between a highlight and whatever is next to it or inside it, on every side */
            margin-block: 4px;
            padding-block: 4px;

            /* behind the rows, inset from the rail's edges without moving them */
            &::before {
                content: "";
                position: absolute;
                inset: 0 6px;
                z-index: -1;
                border-radius: 16px;
                background-color: var(--cpd-color-bg-subtle-secondary);
            }

            &.mx_SpaceItem_subspace::before {
                inset: 0 10px;
                border-radius: 14px;
                background-color: var(--cpd-color-bg-subtle-primary);
            }
        }

        /*
         * Every row's highlight (selected, hover) ends 14px from each edge of the rail, whatever the row is and however
         * deep it is, with the 4px of padding round its 32px icon: it is inside the group trays (which are 6px and 10px
         * from the edge), and as high as a space's row. In the icons only rail it is a 40px tile.
         */
        --fragmentXRowInset: calc(var(--fragmentXRailAxis) - 16px - 4px);

        .mx_SpaceRoomItem {
            box-sizing: border-box;
            padding-inline: var(--fragmentXRowInset);
        }

        /* (under .mx_SpaceRoomItem to win over the rail's own row padding) */
        .mx_SpaceRoomItem .mx_SpaceRoomRow {
            box-sizing: border-box;
            width: 100%;
            padding-block: 4px;
        }

        /* no gap before the (empty) badge, so nothing pushes the avatar off the axis; 40px high like a space's row */
        .mx_SpaceRoomItem .mx_SpaceRoomRow.mx_SpaceRoomRow_narrow {
            padding: 4px 0;
            gap: 0;
        }

        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_narrow) {
            /* the avatar is 4px inside the highlight, on the axis, and the name lines up with the names of the spaces */
            padding-left: 4px;
            gap: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 16px);
        }

        /* a space's highlight is symmetric too: the same inset on the right as on the left */
        .mx_SpaceItem:not(.mx_SpaceItem_narrow) > .mx_SpaceButton {
            padding-right: var(--fragmentXRowInset);

            .mx_SpaceButton_selectionWrapper {
                flex: 1 1 auto;
                width: auto;
            }
        }

        .mx_SpaceItem:not(.mx_SpaceItem_narrow):not(.hasSubSpaces) > .mx_SpaceButton {
            width: calc(100% - var(--fragmentXRowInset));
        }

        .mx_SpaceRoomGroupLabel {
            padding-left: var(--fragmentXRailText);
        }

        /*
         * A room's icon often fills its square, so it keeps its corners: the square avatar type rounds by 25% (8px at
         * this size), which cuts the corners off. People (direct messages) stay round.
         */
        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_withPreview) .mx_BaseAvatar {
            --cpd-avatar-radius: 4px;
        }

        /*
         * An avatar is never squeezed: in the icons only rail a row is 36px wide and held the 32px avatar, an 8px gap and
         * the (empty) badge, so the avatar shrank to about 28px wide and kept its 32px height, which crops its sides.
         */
        .mx_SpaceRoomRow .mx_BaseAvatar {
            flex: none;
        }

        /*
         * No arrows and no pills in the left column: a space opens when the selection is in it (see SpaceItem), the
         * selected server shows as a rounded square, and what is unread shows in the badge and the summary line.
         */
        .mx_SpaceButton_toggleCollapse {
            /* hidden, not removed: its width keeps the gutter that puts the icon on the axis */
            visibility: hidden;
        }

        .mx_SpaceButton.mx_SpaceButton_active .mx_SpaceButton_selectionWrapper::before,
        .mx_SpaceButton.mx_SpaceButton_unread .mx_SpaceButton_selectionWrapper::before {
            display: none;
        }

        /*
         * Search sits in the first cell, as high as the top bar, so it is centred on the bar next to it as well as on the
         * column. Collapse and the other icon buttons below have the small padding all round.
         */
        > .mx_RailButton {
            margin-top: var(--fragmentXIconPad);
            margin-bottom: var(--fragmentXIconPad);
        }

        /* expanded: the glyph is centred on the axis (4px of button padding, then the 24px glyph) */
        > .mx_RailButton.expanded {
            margin-left: calc(var(--fragmentXRailAxis) - 16px);
        }

        > .mx_RailButton:first-of-type {
            margin-top: calc((var(--fragmentXFrameCell) - 32px) / 2);
        }

        .mx_ThreadsActivityCentreButton {
            margin-top: var(--fragmentXIconPad);
            margin-bottom: var(--fragmentXIconPad);
        }

        /* The bottom column (Inbox, settings, the user's avatar) is on the same axis as the rail's icons. */
        .mx_ThreadsActivityCentreButton.expanded {
            /* 4px of button padding, then the 24px glyph, centred on the axis */
            margin-left: calc(var(--fragmentXRailAxis) - 16px);

            /* and the label starts where the names of the spaces do */
            .mx_ThreadsActivityCentreButton_Icon {
                margin-right: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 12px);
            }
        }

        /* The user's avatar sits in a cell as high as the top bar, centred, level with the composer row. */
        .mx_UserPanel {
            min-height: var(--fragmentXFrameCell);
            box-sizing: border-box;
        }

        .mx_UserPanel:not(.mx_UserPanel_compact) {
            padding-left: calc(var(--fragmentXRailAxis) - 16px);
        }

        .mx_UserPanel_menu {
            /* the shared user menu gives its avatar button side margins; the panel's padding places it instead */
            > button {
                /* the 8px after the avatar puts the name where the names of the spaces start */
                margin: 0 8px 0 0;
                padding: 0;
            }

            /* the same 32px as the other icons (the shared avatar is 36px) */
            [style*="--cpd-avatar-size"] {
                --cpd-avatar-size: 32px !important;
            }
        }

        .mx_UserPanel_compact .mx_UserPanel_menu {
            flex: 0 0 auto;

            /* icons only: no name, so no gap after the avatar to push it off the axis */
            > button {
                margin-right: 0;
            }
        }
    }
}
