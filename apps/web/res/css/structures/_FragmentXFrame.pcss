/*
 * fragment_x.unified_frame: the rail and the top bar are one frame around the chat, and the icons in the bars share a
 * size. LoggedInView puts the class on the app wrapper.
 */
.mx_MatrixChat_fragmentXFrame {
    /* The top bar has the rail's colour (the colour editor's Server rail colour sets both), and no line under it. */
    .mx_RoomHeader,
    .mx_RoomHeader:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-bottom-color: transparent;
    }

    /* Every icon in the bars is a 24px glyph in a 32px button. */
    /* (.mx_SpaceButton too: this file loads before _SpacePanel.pcss, so it needs the higher specificity to win) */
    .mx_SpacePanel .mx_SpaceButton .mx_SpaceButton_icon {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    .mx_MessageComposer_button {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    /*
     * One icon axis: the icon of every row, whatever its depth, is centred on the same vertical line, so the rail reads as
     * one column. A space, a subspace, a room, Messages, Servers and a direct message all have the same 32px icon, so
     * there is no indent and no size to tell them apart: the highlights below group an open space and its subspaces.
     */
    .mx_SpacePanel {
        /* the centre of the slot: the gutter (14px), the selection padding (4px) and half the icon (16px) */
        --fragmentXRailAxis: 34px;
        /* where names start: after the slot and a gap */
        --fragmentXRailText: 58px;

        .mx_SpaceTreeLevel .mx_SpaceTreeLevel {
            padding-left: 0;
        }

        /*
         * Two levels of highlight: an open space and everything under it share one, and each open subspace with its rooms
         * has a second, darker one inset in it, so a subspace reads as a tray inside its space.
         */
        .mx_SpaceItem.hasSubSpaces:not(.collapsed) {
            position: relative;
            isolation: isolate;

            /* behind the rows, inset from the rail's edges without moving them */
            &::before {
                content: "";
                position: absolute;
                inset: 0 6px;
                z-index: -1;
                border-radius: 16px;
                background-color: var(--cpd-color-bg-subtle-secondary);
            }

            &.mx_SpaceItem_subspace::before {
                inset: 0 10px;
                border-radius: 14px;
                background-color: var(--cpd-color-bg-subtle-primary);
            }
        }

        /* In the icons only rail a room is a centred tile, so its highlight stays inside the group's. */
        .mx_SpaceRoomRow.mx_SpaceRoomRow_narrow {
            width: 36px;
            margin: 0 auto;
            padding: 3px 0;
        }

        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_narrow) {
            /* a 32px avatar, like a space's, centres on the axis, and the name lines up with the names of the spaces */
            padding-left: calc(var(--fragmentXRailAxis) - 16px);
            gap: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 16px);
        }

        .mx_SpaceRoomGroupLabel {
            padding-left: var(--fragmentXRailText);
        }
    }
}
