/*
 * fragment_x.unified_frame: the rail and the top bar are one frame around the chat, and the icons in the bars share a
 * size. LoggedInView puts the class on the app wrapper.
 */
.mx_MatrixChat_fragmentXFrame {
    /*
     * The frame is a grid of square cells as wide as the rail. The top bar is one cell high, so the search icon sits at
     * the centre of both the rail column and the bar next to it, and an icon at the right end of the bar is as far from
     * the edge as the search icon is from the left one.
     */
    --fragmentXFrameCell: 68px;
    /* the corner where the rail and the top bar meet the chat */
    --fragmentXFrameRadius: 16px;
    /* an icon button is 32px, with 8px around it in a small cell */
    --fragmentXIconPad: 8px;

    /*
     * The corner where the rail and the top bar meet the chat is rounded. It is a notch in the frame's colour laid over
     * the chat's own corner, so it does not depend on what colour the chat has.
     */
    .mx_RoomView_timeline {
        position: relative;

        &::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            z-index: 5;
            width: var(--fragmentXFrameRadius);
            height: var(--fragmentXFrameRadius);
            pointer-events: none;
            background-color: var(--cpd-color-bg-subtle-primary);
            mask: radial-gradient(
                circle at 100% 100%,
                transparent var(--fragmentXFrameRadius),
                #000 calc(var(--fragmentXFrameRadius) + 0.5px)
            );
        }
    }

    /*
     * The right panel is part of the frame: the frame's colour, no line, and the chat's corner next to it is rounded the
     * same way as the one at the top left.
     */
    .mx_RightPanel {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-left-color: transparent;
    }

    .mx_MainSplit:has(.mx_RightPanel_ResizeWrapper) .mx_RoomView_timeline {
        margin-right: 0;

        &::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            z-index: 5;
            width: var(--fragmentXFrameRadius);
            height: var(--fragmentXFrameRadius);
            pointer-events: none;
            background-color: var(--cpd-color-bg-subtle-primary);
            mask: radial-gradient(
                circle at 0 100%,
                transparent var(--fragmentXFrameRadius),
                #000 calc(var(--fragmentXFrameRadius) + 0.5px)
            );
        }
    }

    /*
     * The composer row is centred in a cell as high as the top bar, which puts it level with the user's avatar at the
     * bottom of the rail. A composer with several lines grows upwards from there. The message box is part of the frame:
     * the colour of the rail and the top bar, and the chat's two bottom corners are rounded like the top ones, each a
     * notch in the frame's colour over the chat's own corner.
     */
    .mx_RoomView .mx_MessageComposer {
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        min-height: var(--fragmentXFrameCell);
        padding-bottom: 0;
        position: relative;
        margin-right: 0;
        background-color: var(--cpd-color-bg-subtle-primary);

        &::before,
        &::after {
            content: "";
            position: absolute;
            bottom: 100%;
            z-index: 5;
            width: var(--fragmentXFrameRadius);
            height: var(--fragmentXFrameRadius);
            pointer-events: none;
            background-color: var(--cpd-color-bg-subtle-primary);
        }

        &::before {
            left: 0;
            mask: radial-gradient(
                circle at 100% 0,
                transparent var(--fragmentXFrameRadius),
                #000 calc(var(--fragmentXFrameRadius) + 0.5px)
            );
        }

        /* the right corner only has a neighbour to round against while the right panel is open */
        &::after {
            display: none;
            right: 0;
            mask: radial-gradient(
                circle at 0 0,
                transparent var(--fragmentXFrameRadius),
                #000 calc(var(--fragmentXFrameRadius) + 0.5px)
            );
        }
    }

    .mx_MainSplit:has(.mx_RightPanel_ResizeWrapper) .mx_MessageComposer::after {
        display: block;
    }

    /*
     * The reply preview is a rounded card in the rail's tone on the frame colour (12px, like the trays in the rail), with
     * no hairline and no shadow, and the same light grey for its text and the close icon as the rest of the frame.
     */
    .mx_RoomView_body .mx_ReplyPreview {
        margin-block: var(--fragmentXIconPad) 0;
        border: 0;
        border-radius: 12px;
        box-shadow: none;
        background: var(--cpd-color-bg-subtle-secondary);

        .mx_ReplyPreview_section {
            border-bottom: 0;
            padding: var(--cpd-space-2x) var(--cpd-space-3x);
        }

        .mx_ReplyPreview_header {
            color: var(--cpd-color-text-secondary);
            opacity: 1;
            font: var(--cpd-font-body-sm-medium);

            .mx_ReplyPreview_header_cancel svg {
                color: var(--cpd-color-icon-secondary);
                fill: var(--cpd-color-icon-secondary);
            }

            .mx_ReplyPreview_header_cancel:hover svg {
                color: var(--cpd-color-icon-primary);
                fill: var(--cpd-color-icon-primary);
            }
        }
    }

    .mx_MessageComposer_wrapper {
        margin: 0;
        /* no line above the text box: it has the frame's colour, not the chat's */
        border-top-color: transparent;
    }

    /*
     * One hover for every icon that is not a person, a space or a room: no box behind it, the icon brightens and
     * glows. (Search, Collapse, Inbox, settings and the icons in the top bar.)
     */
    .mx_RailButton,
    .mx_ThreadsActivityCentreButton,
    .mx_UserPanel_button,
    .mx_RoomHeader [class*="_icon-button_"] {
        &:hover,
        &:focus-visible {
            background-color: transparent !important;
        }

        svg {
            transition:
                filter 0.15s ease,
                fill 0.15s ease;
        }

        &:hover svg,
        &:focus-visible svg {
            fill: var(--cpd-color-icon-primary) !important;
            filter: drop-shadow(0 0 5px var(--cpd-color-icon-primary));
        }
    }

    /*
     * One light grey for every icon button in the rail, the top bar and the composer; white while the pointer is over it
     * or it has focus, while it is selected or pressed, and for the Inbox while it has something unread.
     */
    .mx_RailButton,
    .mx_ThreadsActivityCentreButton,
    .mx_UserPanel_button,
    .mx_SpaceButton .mx_SpaceButton_icon,
    .mx_RoomHeader [class*="_icon-button_"],
    .mx_MessageComposer_button,
    .mx_MessageComposer [class*="_icon-button_"] {
        svg {
            fill: var(--cpd-color-icon-secondary) !important;
            color: var(--cpd-color-icon-secondary) !important;
        }
    }

    .mx_RailButton:hover svg,
    .mx_RailButton:focus-visible svg,
    .mx_ThreadsActivityCentreButton:hover svg,
    .mx_ThreadsActivityCentreButton:focus-visible svg,
    .mx_ThreadsActivityCentreButton_unread svg,
    .mx_UserPanel_button:hover svg,
    .mx_UserPanel_button:focus-visible svg,
    .mx_SpaceButton:hover .mx_SpaceButton_icon svg,
    .mx_SpaceButton.mx_SpaceButton_active .mx_SpaceButton_icon svg,
    .mx_RoomHeader [class*="_icon-button_"]:hover svg,
    .mx_RoomHeader [class*="_icon-button_"]:focus-visible svg,
    .mx_RoomHeader [class*="_icon-button_"][aria-pressed="true"] svg,
    .mx_RoomHeader [class*="_icon-button_"][aria-expanded="true"] svg,
    .mx_MessageComposer_button:hover svg,
    .mx_MessageComposer [class*="_icon-button_"]:hover svg,
    .mx_MessageComposer [class*="_icon-button_"]:focus-visible svg {
        fill: var(--cpd-color-icon-primary) !important;
        color: var(--cpd-color-icon-primary) !important;
    }

    /* the avatar's centre is 34px from the bottom, and the settings icon is one icon pitch above it */
    .mx_SpacePanel.mx_SpacePanel_unified .mx_UserPanel.mx_UserPanel_compact {
        padding: var(--fragmentXIconPad) 0 calc((var(--fragmentXFrameCell) - 32px) / 2);
        gap: calc(var(--fragmentXIconPad) * 2);
    }

    /* the icon buttons of the rail set their own box with !important on :not(.expanded):hover, so these match that */
    .mx_RailButton:not(.expanded):hover,
    .mx_ThreadsActivityCentreButton:not(.expanded):hover,
    .mx_ThreadsActivityCentreButton:not(.expanded):hover .mx_ThreadsActivityCentreButton_Icon {
        background-color: transparent !important;
    }

    .mx_ThreadsActivityCentreButton:hover .mx_ThreadsActivityCentreButton_Icon {
        background-color: transparent !important;
    }

    /* The top bar has the rail's colour (the colour editor's Server rail colour sets both), and no line under it. */
    .mx_RoomHeader,
    .mx_RoomHeader:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-bottom-color: transparent;
    }

    .mx_RoomHeader {
        height: var(--fragmentXFrameCell);
        /* no line under it, so the icons are centred on the whole height */
        border-bottom-width: 0;
        /* icon buttons 32px apart from each other: the small padding twice */
        gap: calc(var(--fragmentXIconPad) * 2);
        /* the icon at the right end is as far from the edge as the search icon is from the left one: 34px to its centre */
        padding-right: calc(var(--fragmentXFrameCell) / 2 - 16px);
    }

    /* Every icon in the bars is a 24px glyph in a 32px button. */
    /* (.mx_SpaceButton too: this file loads before _SpacePanel.pcss, so it needs the higher specificity to win) */
    .mx_SpacePanel .mx_SpaceButton .mx_SpaceButton_icon {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    .mx_MessageComposer_button {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    /*
     * One icon axis: the icon of every row, whatever its depth, is centred on the same vertical line, so the rail reads as
     * one column. A space, a subspace, a room, Messages, Servers and a direct message all have the same 32px icon, so
     * there is no indent and no size to tell them apart: the highlights below group an open space and its subspaces.
     */
    .mx_SpacePanel {
        /* the centre of the slot: the gutter (14px), the selection padding (4px) and half the icon (16px) */
        --fragmentXRailAxis: 34px;
        /* where names start: after the slot and a gap */
        --fragmentXRailText: 58px;

        .mx_SpaceTreeLevel .mx_SpaceTreeLevel {
            padding-left: 0;
        }

        /* the tree is as wide as the rail (it stopped 22px short), so the trays and rows are inset the same on both sides */
        .mx_SpaceTreeLevel {
            max-width: none;
        }

        /*
         * Two levels of highlight: an open space and everything under it share one, and each open subspace with its rooms
         * has a second, darker one inset in it, so a subspace reads as a tray inside its space.
         */
        .mx_SpaceItem.hasSubSpaces:not(.collapsed) {
            position: relative;
            isolation: isolate;
            /* the same 4px between a highlight and whatever is next to it or inside it, on every side */
            margin-block: 4px;
            padding-block: 4px;

            /* behind the rows, inset from the rail's edges without moving them */
            &::before {
                content: "";
                position: absolute;
                inset: 0 6px;
                z-index: -1;
                border-radius: 16px;
                background-color: var(--cpd-color-bg-subtle-secondary);
            }

            &.mx_SpaceItem_subspace::before {
                inset: 0 10px;
                /* concentric with the group (16px) and the rows (8px): 4px apart each */
                border-radius: 12px;
                background-color: var(--cpd-color-bg-subtle-primary);
            }
        }

        /*
         * Every row's highlight (selected, hover) ends 14px from each edge of the rail, whatever the row is and however
         * deep it is, with the 4px of padding round its 32px icon: it is inside the group trays (which are 6px and 10px
         * from the edge), and as high as a space's row. In the icons only rail it is a 40px tile.
         */
        --fragmentXRowInset: calc(var(--fragmentXRailAxis) - 16px - 4px);

        .mx_SpaceRoomItem {
            box-sizing: border-box;
            padding-inline: var(--fragmentXRowInset);
        }

        /* (under .mx_SpaceRoomItem to win over the rail's own row padding) */
        .mx_SpaceRoomItem .mx_SpaceRoomRow {
            box-sizing: border-box;
            width: 100%;
            padding-block: 4px;
        }

        /* no gap before the (empty) badge, so nothing pushes the avatar off the axis; 40px high like a space's row */
        .mx_SpaceRoomItem .mx_SpaceRoomRow.mx_SpaceRoomRow_narrow {
            padding: 4px 0;
            gap: 0;
        }

        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_narrow) {
            /* the avatar is 4px inside the highlight, on the axis, and the name lines up with the names of the spaces */
            padding-left: 4px;
            gap: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 16px);
        }

        /* ...and the same corners as a room's (8px, the rooms' own), so no highlight in the column is rounder than another */
        .mx_SpaceButton .mx_SpaceButton_selectionWrapper {
            border-radius: 8px;
        }

        /* a space's highlight is symmetric too: the same inset on the right as on the left */
        .mx_SpaceItem:not(.mx_SpaceItem_narrow) > .mx_SpaceButton {
            padding-right: var(--fragmentXRowInset);

            .mx_SpaceButton_selectionWrapper {
                flex: 1 1 auto;
                width: auto;
            }
        }

        .mx_SpaceItem:not(.mx_SpaceItem_narrow):not(.hasSubSpaces) > .mx_SpaceButton {
            width: calc(100% - var(--fragmentXRowInset));
        }

        .mx_SpaceRoomGroupLabel {
            padding-left: var(--fragmentXRailText);
        }

        /*
         * One shape for every user, space, subspace and room icon: a circle, and a rounded square while the pointer is
         * over it or it is selected (the spaces do this in _SpacePanel.pcss; rooms, direct messages and the user's own
         * avatar here).
         */
        .mx_SpaceRoomRow .mx_BaseAvatar,
        .mx_UserPanel_menu [style*="--cpd-avatar-size"] {
            --cpd-avatar-radius: 50%;
            transition: border-radius 0.15s ease-out;

            img {
                transition: border-radius 0.15s ease-out;
            }
        }

        .mx_SpaceRoomRow:hover .mx_BaseAvatar,
        .mx_SpaceRoomRow.mx_SpaceRoomRow_selected .mx_BaseAvatar,
        .mx_UserPanel_menu > button:hover [style*="--cpd-avatar-size"],
        .mx_UserPanel_menu > button[aria-expanded="true"] [style*="--cpd-avatar-size"] {
            --cpd-avatar-radius: 30%;
        }

        /*
         * An avatar is never squeezed: in the icons only rail a row is 36px wide and held the 32px avatar, an 8px gap and
         * the (empty) badge, so the avatar shrank to about 28px wide and kept its 32px height, which crops its sides.
         */
        .mx_SpaceRoomRow .mx_BaseAvatar {
            flex: none;
        }

        /*
         * No arrows and no pills in the left column: a space opens when the selection is in it (see SpaceItem), the
         * selected server shows as a rounded square, and what is unread shows in the badge and the summary line.
         */
        .mx_SpaceButton_toggleCollapse {
            /* hidden, not removed: its width keeps the gutter that puts the icon on the axis */
            visibility: hidden;
        }

        .mx_SpaceButton.mx_SpaceButton_active .mx_SpaceButton_selectionWrapper::before,
        .mx_SpaceButton.mx_SpaceButton_unread .mx_SpaceButton_selectionWrapper::before {
            display: none;
        }

        /*
         * Search sits in the first cell, as high as the top bar, so it is centred on the bar next to it as well as on the
         * column. Collapse and the other icon buttons below have the small padding all round.
         */
        > .mx_RailButton {
            margin-top: var(--fragmentXIconPad);
            margin-bottom: var(--fragmentXIconPad);
        }

        /* expanded: the glyph is centred on the axis (4px of button padding, then the 24px glyph) */
        > .mx_RailButton.expanded {
            margin-left: calc(var(--fragmentXRailAxis) - 16px);
        }

        > .mx_RailButton:first-of-type {
            margin-top: calc((var(--fragmentXFrameCell) - 32px) / 2);
        }

        .mx_ThreadsActivityCentreButton {
            margin-top: var(--fragmentXIconPad);
            margin-bottom: var(--fragmentXIconPad);
        }

        /* The bottom column (Inbox, settings, the user's avatar) is on the same axis as the rail's icons. */
        .mx_ThreadsActivityCentreButton.expanded {
            /* 4px of button padding, then the 24px glyph, centred on the axis */
            margin-left: calc(var(--fragmentXRailAxis) - 16px);

            /* and the label starts where the names of the spaces do */
            .mx_ThreadsActivityCentreButton_Icon {
                margin-right: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 12px);
            }
        }

        /*
         * Expanded, the Inbox is an icon next to the settings icon in the user's row (the same 48px pitch as the icons in the
         * top bar), not a row of its own. Collapsed, it stays in the column above the settings icon.
         */
        &:not(.collapsed) .mx_ThreadsActivityCentre_container {
            position: absolute;
            inset-inline-end: calc(var(--fragmentXIconPad) * 7);
            inset-block-end: calc((var(--fragmentXFrameCell) - 32px) / 2);
            z-index: 1;

            .mx_ThreadsActivityCentreButton {
                margin: 0;
            }
        }

        /* without the settings icon the Inbox is the last one in the row */
        &.mx_SpacePanel_settingsInMenu:not(.collapsed) .mx_ThreadsActivityCentre_container {
            inset-inline-end: var(--fragmentXIconPad);
        }

        /* The user's avatar sits in a cell as high as the top bar, centred, level with the composer row. */
        .mx_UserPanel {
            min-height: var(--fragmentXFrameCell);
            box-sizing: border-box;
        }

        .mx_UserPanel:not(.mx_UserPanel_compact) {
            padding-left: calc(var(--fragmentXRailAxis) - 16px);
        }

        .mx_UserPanel_menu {
            /* the shared user menu gives its avatar button side margins; the panel's padding places it instead */
            > button {
                /* the 8px after the avatar puts the name where the names of the spaces start */
                margin: 0 8px 0 0;
                padding: 0;
            }

            /* the same 32px as the other icons (the shared avatar is 36px) */
            [style*="--cpd-avatar-size"] {
                --cpd-avatar-size: 32px !important;
            }

            /* the presence dot sits at the bottom of the 32px avatar, ringed in the rail's colour */
            --cpd-user-menu-avatar-size: 32px;
            --cpd-user-menu-presence-ring: var(--cpd-color-bg-subtle-primary);
        }

        .mx_UserPanel_compact .mx_UserPanel_menu {
            flex: 0 0 auto;

            /* icons only: no name, so no gap after the avatar to push it off the axis */
            > button {
                margin-right: 0;
            }
        }
    }
}

/*
 * The menu items of the room info card and of the user menu have no box of their own: they take the colour behind them,
 * and the item under the pointer or focus has the rounded highlight of the expanded rail's rows. (The user menu is in a
 * portal, outside the app wrapper, so it is found from the body.)
 */
.mx_MatrixChat_fragmentXFrame .mx_RoomSummaryCard [role^="menuitem"],
body:has(.mx_MatrixChat_fragmentXFrame) [role="menu"] [role^="menuitem"] {
    margin-inline: 8px;
    /* the items are as wide as their container, so the margin on both sides is taken off the width */
    width: calc(100% - 16px);
    box-sizing: border-box;
    border-radius: 8px;
    background-color: transparent;

    &:hover,
    &:focus-visible {
        background-color: $panel-actions;
    }
}

/* no line under the search box of the side panel */
.mx_MatrixChat_fragmentXFrame .mx_BaseCard .mx_BaseCard_header {
    border-block-end-color: transparent;
}

/* The inbox opens from the user menu, so its button is only an anchor for the popup, out of sight. */
.mx_MatrixChat_fragmentXFrame .mx_ThreadsActivityCentre_container.mx_ThreadsActivityCentre_inUserMenu {
    position: fixed !important;
    inset: auto auto 8px 8px !important;
    width: 32px;
    height: 32px;
    visibility: hidden;
    pointer-events: none;
}

/*
 * fragment_x.rail_tab: the selected room or conversation is a tab. It has the chat's colour and runs to the chat's edge, and
 * the corners where it meets the chat curve into it (the same radius as the corner of the chat), so rail and chat read as
 * one shape. The open groups (spaces and subspaces) keep their own, lighter tray behind it.
 */
.mx_MatrixChat_fragmentXRailTab .mx_SpacePanel.mx_SpacePanel_unified {
    /* how far a tab runs past its row to reach the chat: the row's inset and the gutter after the tree */
    --fragmentXTabReach: calc(var(--fragmentXRowInset) + var(--fragmentXTabGutter, 0px));

    .mx_SpaceRoomRow.mx_SpaceRoomRow_selected {
        position: relative;
        z-index: 1;
        background-color: $background;
        border-start-start-radius: var(--fragmentXFrameRadius);
        border-end-start-radius: var(--fragmentXFrameRadius);
        border-start-end-radius: 0;
        border-end-end-radius: 0;

        /* the part of the tab between the row and the chat, and the two curves at its top and bottom */
        &::before {
            content: "";
            position: absolute;
            inset-block: calc(-1 * var(--fragmentXFrameRadius));
            inset-inline-start: calc(100% - 1px);
            width: calc(var(--fragmentXTabReach) + 1px);
            pointer-events: none;
            background:
                radial-gradient(
                        circle at 0 0,
                        transparent var(--fragmentXFrameRadius),
                        $background calc(var(--fragmentXFrameRadius) + 0.5px)
                    )
                    right top / var(--fragmentXFrameRadius) var(--fragmentXFrameRadius) no-repeat,
                radial-gradient(
                        circle at 0 100%,
                        transparent var(--fragmentXFrameRadius),
                        $background calc(var(--fragmentXFrameRadius) + 0.5px)
                    )
                    right bottom / var(--fragmentXFrameRadius) var(--fragmentXFrameRadius) no-repeat,
                linear-gradient($background, $background) left center / 100%
                    calc(100% - 2 * var(--fragmentXFrameRadius)) no-repeat;
        }
    }

    /* a group that holds the tab paints above the groups after it, or their tray would cover the curve below the tab */
    .mx_SpaceItem.hasSubSpaces:not(.collapsed):has(.mx_SpaceRoomRow_selected) {
        z-index: 1;
    }
}

/*
 * The rail's scroll area reserves a gutter for a scrollbar (8px to 11px, and more or less in each browser), which squeezes
 * the tree and puts every icon left of the rail's centre. The rail scrolls without a visible bar, so there is no gutter, and
 * every icon is centred on the rail's axis.
 */
.mx_MatrixChat_fragmentXFrame .mx_SpacePanel.mx_SpacePanel_unified .mx_AutoHideScrollbar {
    scrollbar-width: none;
    scrollbar-gutter: auto;

    &::-webkit-scrollbar {
        display: none;
    }
}
