/*
 * fragment_x.unified_frame: the rail and the top bar are one frame around the chat, and the icons in the bars share a
 * size. LoggedInView puts the class on the app wrapper.
 */
.mx_MatrixChat_fragmentXFrame {
    /* The top bar has the rail's colour (the colour editor's Server rail colour sets both), and no line under it. */
    .mx_RoomHeader,
    .mx_RoomHeader:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
        border-bottom-color: transparent;
    }

    /* Every icon in the bars is a 24px glyph in a 32px button. */
    /* (.mx_SpaceButton too: this file loads before _SpacePanel.pcss, so it needs the higher specificity to win) */
    .mx_SpacePanel .mx_SpaceButton .mx_SpaceButton_icon {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    .mx_MessageComposer_button {
        width: 24px;
        height: 24px;
        padding: 4px;
    }

    /*
     * One icon axis: the icon of every row, whatever its depth, is centred on the same vertical line, so the rail reads as
     * one column. A space, a subspace, a room, Messages, Servers and a direct message all have the same 32px icon, so
     * there is no indent and no size to tell them apart: the highlights below group an open space and its subspaces.
     */
    .mx_SpacePanel {
        /* the centre of the slot: the gutter (14px), the selection padding (4px) and half the icon (16px) */
        --fragmentXRailAxis: 34px;
        /* where names start: after the slot and a gap */
        --fragmentXRailText: 58px;

        .mx_SpaceTreeLevel .mx_SpaceTreeLevel {
            padding-left: 0;
        }

        /*
         * Two levels of highlight: an open space and everything under it share one, and each open subspace with its rooms
         * has a second, darker one inset in it, so a subspace reads as a tray inside its space.
         */
        .mx_SpaceItem.hasSubSpaces:not(.collapsed) {
            position: relative;
            isolation: isolate;

            /* behind the rows, inset from the rail's edges without moving them */
            &::before {
                content: "";
                position: absolute;
                inset: 0 6px;
                z-index: -1;
                border-radius: 16px;
                background-color: var(--cpd-color-bg-subtle-secondary);
            }

            &.mx_SpaceItem_subspace::before {
                inset: 0 10px;
                border-radius: 14px;
                background-color: var(--cpd-color-bg-subtle-primary);
            }
        }

        /* In the icons only rail a room is a centred tile, so its highlight stays inside the group's. */
        .mx_SpaceRoomRow.mx_SpaceRoomRow_narrow {
            width: 36px;
            margin: 0 auto;
            padding: 3px 0;
            /* no gap before the (empty) badge, so nothing pushes the avatar off the axis */
            gap: 0;
        }

        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_narrow) {
            /* a 32px avatar, like a space's, centres on the axis, and the name lines up with the names of the spaces */
            padding-left: calc(var(--fragmentXRailAxis) - 16px);
            gap: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 16px);
        }

        .mx_SpaceRoomGroupLabel {
            padding-left: var(--fragmentXRailText);
        }

        /*
         * A room's icon often fills its square, so it keeps its corners: the square avatar type rounds by 25% (8px at
         * this size), which cuts the corners off. People (direct messages) stay round.
         */
        .mx_SpaceRoomRow:not(.mx_SpaceRoomRow_withPreview) .mx_BaseAvatar {
            --cpd-avatar-radius: 4px;
        }

        /*
         * An avatar is never squeezed: in the icons only rail a row is 36px wide and held the 32px avatar, an 8px gap and
         * the (empty) badge, so the avatar shrank to about 28px wide and kept its 32px height, which crops its sides.
         */
        .mx_SpaceRoomRow .mx_BaseAvatar {
            flex: none;
        }

        /*
         * No arrows and no pills in the left column: a space opens when the selection is in it (see SpaceItem), the
         * selected server shows as a rounded square, and what is unread shows in the badge and the summary line.
         */
        .mx_SpaceButton_toggleCollapse {
            /* hidden, not removed: its width keeps the gutter that puts the icon on the axis */
            visibility: hidden;
        }

        .mx_SpaceButton.mx_SpaceButton_active .mx_SpaceButton_selectionWrapper::before,
        .mx_SpaceButton.mx_SpaceButton_unread .mx_SpaceButton_selectionWrapper::before {
            display: none;
        }

        /* The bottom column (Inbox, settings, the user's avatar) is on the same axis as the rail's icons. */
        .mx_ThreadsActivityCentreButton.expanded {
            /* 4px of button padding, then the 24px glyph, centred on the axis */
            margin-left: calc(var(--fragmentXRailAxis) - 16px);

            /* and the label starts where the names of the spaces do */
            .mx_ThreadsActivityCentreButton_Icon {
                margin-right: calc(var(--fragmentXRailText) - var(--fragmentXRailAxis) - 12px);
            }
        }

        .mx_UserPanel:not(.mx_UserPanel_compact) {
            padding-left: calc(var(--fragmentXRailAxis) - 16px);
        }

        .mx_UserPanel_menu {
            /* the shared user menu gives its avatar button side margins; the panel's padding places it instead */
            > button {
                /* the 8px after the avatar puts the name where the names of the spaces start */
                margin: 0 8px 0 0;
                padding: 0;
            }

            /* the same 32px as the other icons (the shared avatar is 36px) */
            [style*="--cpd-avatar-size"] {
                --cpd-avatar-size: 32px !important;
            }
        }

        .mx_UserPanel_compact .mx_UserPanel_menu {
            flex: 0 0 auto;

            /* icons only: no name, so no gap after the avatar to push it off the axis */
            > button {
                margin-right: 0;
            }
        }
    }
}
