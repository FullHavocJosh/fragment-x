.mx_MemberListView {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;

    .mx_MemberListView_container {
        height: 100%;
    }

    .mx_MemberListView_separator {
        margin: 0;
        border: none;
        border-top: 2px solid var(--cpd-color-bg-subtle-primary);
    }

    /* Fragment X: a role heading that collapses its members, like Discord's role groups. */
    .mx_MemberListView_roleHeader {
        display: flex;
        align-items: center;
        gap: 4px;
        width: 100%;
        height: 32px;
        padding: 8px 12px 0;
        box-sizing: border-box;
        border: none;
        background: none;
        cursor: pointer;
        text-align: left;
        text-transform: uppercase;
        font: var(--cpd-font-body-xs-semibold);
        letter-spacing: 0.02em;
        color: var(--cpd-color-text-secondary);

        svg {
            flex: 0 0 auto;
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        &:hover {
            color: var(--cpd-color-text-primary);
        }
    }

    /* Fragment X: the user's own entry. */
    .mx_MemberListView_self {
        border-radius: 8px;
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}
