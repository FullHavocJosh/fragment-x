.mx_GifButton_label {
    font: var(--cpd-font-body-xs-semibold);
    border: 1.5px solid currentColor;
    border-radius: 4px;
    padding: 0 3px;
    line-height: 14px;
}

.mx_GifPicker {
    display: flex;
    flex-direction: column;
    width: 420px;
    max-width: 90vw;
    height: 420px;
    max-height: 70vh;
    background: var(--cpd-color-bg-canvas-default);
    border-radius: 12px;
    box-shadow: 0 8px 32px rgb(0 0 0 / 40%);
    overflow: hidden;
}

.mx_GifPicker_search {
    margin: var(--cpd-space-3x) var(--cpd-space-3x) var(--cpd-space-2x);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border: 0;
    border-radius: 8px;
    background: var(--cpd-color-bg-subtle-primary);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);
}

.mx_GifPicker_grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 110px;
    gap: var(--cpd-space-1-5x);
    padding: 0 var(--cpd-space-3x);
    overflow-y: auto;
}

.mx_GifPicker_item {
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: var(--cpd-color-bg-subtle-secondary);
    overflow: hidden;
    cursor: pointer;

    img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    &:hover,
    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-interactive-hovered);
    }
}

.mx_GifPicker_status {
    grid-column: 1 / -1;
    padding: var(--cpd-space-4x);
    text-align: center;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-md-regular);
}

.mx_GifPicker_footer {
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
    text-align: right;
}

.mx_GifBody {
    margin-top: var(--cpd-space-1x);

    img {
        display: block;
        border-radius: 8px;
    }
}
