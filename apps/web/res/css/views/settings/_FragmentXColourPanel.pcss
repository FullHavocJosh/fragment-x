/* Appearance settings: one row per colour the user can choose. */
.mx_FragmentXColourPanel_row {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);
    margin-bottom: var(--cpd-space-3x);

    label {
        flex: 0 0 200px;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);
    }

    input[type="color"] {
        width: 48px;
        height: 32px;
        padding: 0;
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 6px;
        background: none;
        cursor: pointer;
    }
}
